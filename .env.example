# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored -- never commit a real key.
# ---------------------------------------------------------------------------

# --- Anthropic (Claude Opus 5) -------------------------------------------
# Required for: exact token counts (`count --exact`) and live runs.
# NOTE: Anthropic has NO permanent free tier. The /v1/messages/count_tokens
# endpoint, however, is NOT billed -- so a key with $0 spend still gives you
# exact token accounting. See docs/FREE-API-KEYS.md.
ANTHROPIC_API_KEY=

# --- OpenAI-compatible free provider (for structural sweeps at $0) --------
# Pick ONE of the free providers in docs/FREE-API-KEYS.md and set both vars.
# Examples:
#   Groq          https://api.groq.com/openai/v1
#   OpenRouter    https://openrouter.ai/api/v1
#   Cerebras      https://api.cerebras.ai/v1
#   Google Gemini https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Defaults -------------------------------------------------------------
OPUS5LEAN_MODEL=claude-opus-5
OPUS5LEAN_EFFORT=high
