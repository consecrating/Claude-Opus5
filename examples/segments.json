{
  "model": "claude-opus-5",
  "ttl": "5m",
  "_comment": "A realistic support-agent request, in the order it is sent. volatility: 0=static, 1=per deploy, 2=per session, 3=per turn.",
  "segments": [
    { "name": "tool schemas",       "tokens": 4200,  "volatility": 0 },
    { "name": "system prompt",      "tokens": 6100,  "volatility": 0 },
    { "name": "product docs (RAG)", "tokens": 24000, "volatility": 1 },
    { "name": "account context",    "tokens": 1800,  "volatility": 2 },
    { "name": "conversation so far","tokens": 3400,  "volatility": 3 },
    { "name": "user turn",          "tokens": 120,   "volatility": 3 }
  ]
}
